// ********************** CLEAR **********************
 operation clear(A){
  1: if zero A then goto 0 else goto 2
  2: do dec A goto 1
 }

 // ********************** SOMA 1 **********************
 // A:=A+B (destrutiva)
 operation soma(A,B){
   1: if zero B then goto 0 else goto 2
   2: do dec B goto 3
   3: do inc A goto 1
 }
 
  // ********************** SOMA 2 **********************
 // A:=A+B (não destrutiva)
 operation soma2(A,B,C){
   1: if zero B then goto 5 else goto 2
   2: do dec B goto 3
   3: do inc A goto 4
   4: do inc C goto 1
   5: if zero C then goto 0 else goto 6
   6: do dec C goto 7
   7: do inc B goto 5
 }
 // ********************** ATRIBUIÇÃO 1 **********************
 // A:=B (destrutiva)
 operation load(A,B){
   1: do clear(A) goto 2
   2: do soma(A,B) goto 0
 }
 
// ********************** ATRIBUIÇÃO 2 **********************
 // A:=B usando C (não destrutiva)
 operation load2(A,B,C){
   1: do clear(A) goto 2
   2: do soma2(A,B,C) goto 0
 }
 
 
 
// ********************** MULTIPLICAÇÃO **********************
 // A := A * B (não destrutiva)
 operation multiplica(A,B,C,D) {
   1: do load(C,A) goto 2
   2: if zero C then goto 0 else goto 3
   3: do soma2(A,B,D) goto 4
   4: do dec C goto 2
 }

 // ********************** POTENCIAÇÃO **********************
// A := A ^ B (B diferente de 0, destrutiva)
 operation potencia(A,B,C,D,E,F) {
    1: do load2(E, A, F) goto 2
    2: do dec B goto 3
    3: if zero B then goto 0 else goto 4
    4: do multiplica(A,E,C,D) goto 5
    5: do dec B goto 3
 }




 
 main {
 1: do load2(A,X,C) goto 3
 3: do clear(B) goto 4
 4: do add B 3 goto 5
 5: do potencia(A,B,C,D,E,F) goto 6
 6: do clear(B) goto 7
 7: do add B 2 goto 8
 8: do multiplica(X,B,C,D) goto 9
 9: do soma(A,X) goto 10
 10: do load (Y,A) goto 0
}
	